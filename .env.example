# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
# systemd 는 EnvironmentFile= 로 .env 를 그대로 읽고,
# 로컬에서 수동 실행할 때는 `export $(grep -v '^#' .env | xargs)` 로 로드하거나
# `source .env` (bash에서 `set -a; source .env; set +a`) 로 불러오면 됩니다.

# KRX 정보데이터시스템(data.krx.co.kr) 회원 ID/PW - 2025-12-27부터 로그인 필수 (없으면 시세 조회 실패)
KRX_ID=
KRX_PW=

# opendart.fss.or.kr 에서 무료 발급 (없어도 동작하나 공시 점수가 빠짐)
DART_API_KEY=

# 텔레그램 알림 (BotFather 로 봇 생성 후 토큰 발급, README 참고)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 모바일 웹앱(PWA) 접속 비밀번호 - 외부에 공개된 서버라면 반드시 설정
WEBAPP_USERNAME=admin
WEBAPP_PASSWORD=
